{
  "name": "e-learning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @e-learning/client --filter @e-learning/admin dev",
    "dev:client": "pnpm --filter @e-learning/client dev",
    "dev:admin": "pnpm --filter @e-learning/admin dev",
    "build": "pnpm --filter @e-learning/client --filter @e-learning/admin build",
    "build:client": "pnpm --filter @e-learning/client build",
    "build:admin": "pnpm --filter @e-learning/admin build",
    "lint": "pnpm --filter @e-learning/client --filter @e-learning/admin lint",
    "typecheck": "pnpm --filter @e-learning/client --filter @e-learning/admin typecheck"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
